LangString appRunningOkKill ${LANG_ENGLISH} "${PRODUCTNAME} is running.$\nChoose OK to stop it."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose an installation operation."
LangString choowHowToInstall ${LANG_ENGLISH} "Choose how to install ${PRODUCTNAME}."
LangString createDesktop ${LANG_ENGLISH} "Create a desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Install without uninstalling first"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Installing without uninstalling first is not allowed for this downgrade"
LangString failedToKillApp ${LANG_ENGLISH} "Could not stop ${PRODUCTNAME}. Close it and retry."
LangString installingWebview2 ${LANG_ENGLISH} "Installing the WebView2 runtime..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer ${PRODUCTNAME} version is installed. Installing an older version is not recommended. Choose an operation to continue."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is installed. Choose whether to remove it before installing."
LangString silentDowngrades ${LANG_ENGLISH} "Silent downgrades are disabled. Open the graphical installer to continue."
LangString unableToUninstall ${LANG_ENGLISH} "Uninstall did not complete."
LangString uninstallApp ${LANG_ENGLISH} "Remove ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Remove the existing version first"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "WebView2 installation failed. This application requires WebView2. Retry the installer."
LangString webview2DownloadError ${LANG_ENGLISH} "WebView2 download failed: $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "The WebView2 bootstrapper is ready."
LangString webview2Downloading ${LANG_ENGLISH} "Downloading the WebView2 bootstrapper..."
LangString webview2InstallError ${LANG_ENGLISH} "WebView2 installation returned exit code $1."
